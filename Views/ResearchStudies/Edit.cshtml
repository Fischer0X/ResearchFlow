@model StudyFormViewModel

@{
    ViewData["Title"] = "تعديل الدراسة";
}

<div class="page-head">
    <div>
        <h1>تعديل الدراسة</h1>
        <p class="text-muted">قم بتعديل بيانات الدراسة ثم احفظ التغييرات.</p>
    </div>

    <a class="btn btn-secondary"
       asp-action="Details"
       asp-route-id="@Model.Id">
        العودة للتفاصيل
    </a>
</div>

<div class="panel">
    <form method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <partial name="_Form" model="Model" />

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                حفظ التعديلات
            </button>

            <a class="btn btn-outline-secondary"
               asp-action="Details"
               asp-route-id="@Model.Id">
                إلغاء
            </a>
        </div>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}