@model IEnumerable<ResearchStudy>

@{
    ViewData["Title"] = "Research Studies";
}

<div class="page-head">
    <h1>Research Studies</h1>

    @if (User.IsInRole("LabManager"))
    {
        <a class="btn btn-primary" asp-action="Create">New Research Study</a>
    }
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        var total = item.Phases.Count;
        var done = item.Phases.Count(x => x.Status == ResearchStatus.Completed);
        var percentage = total == 0 ? 0 : Math.Round(done * 100.0 / total);

        string status;

        if (percentage == 100)
        {
            status = "Completed";
        }
        else if (percentage > 0)
        {
            status = "In Progress";
        }
        else
        {
            status = "Not Started";
        }

        <div class="col-md-6">
            <article class="cardx">
                <h3>@item.Title</h3>

                <p>@item.Description</p>

                <div class="progress">
                    <div class="progress-bar"
                         style="width:@percentage%">
                    </div>
                </div>

                <div class="mt-2">
                    <strong>Progress:</strong> @percentage%
                </div>

                <div>
                    <strong>Phases:</strong> @done / @total completed
                </div>

                <div class="mt-2">
                    <strong>Status:</strong> @status
                </div>

                <a class="stretched-link"
                   asp-action="Details"
                   asp-route-id="@item.Id">
                </a>
            </article>
        </div>
    }
</div>