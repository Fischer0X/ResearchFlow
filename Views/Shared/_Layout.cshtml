<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] - ResearchFlow</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.rtl.min.css" rel="stylesheet"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"></head><body><nav class="navbar navbar-expand-lg navbar-dark"><div class="container"><a class="navbar-brand" asp-controller="Home" asp-action="Index"><b>RF</b> ResearchFlow</a><div class="navbar-nav"><a class="nav-link" asp-controller="ResearchStudies" asp-action="Index">الدراسات</a><a class="nav-link" asp-controller="ResearchPhases" asp-action="MyWork">أعمالي</a></div><partial name="_LoginPartial" /></div></nav><main class="container py-4">@if(TempData["Error"] is not null){<div class="alert alert-danger">@TempData["Error"]</div>}@RenderBody()</main><footer><div class="container">ResearchFlow - نظام إدارة المختبر البحثي</div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>